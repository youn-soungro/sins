# ── 데이터베이스 (PostgreSQL) ─────────────────────────────
DATABASE_URL="postgresql://사용자:비밀번호@localhost:5432/sins_attendance?schema=public"

# ── 인증 ─────────────────────────────────────────────────
# 32자 이상의 임의 문자열로 반드시 변경하세요.
JWT_SECRET="여기에-충분히-긴-임의의-비밀키를-입력하세요"

# 최초 관리자 계정 (seed 실행 시 사용)
ADMIN_LOGIN_ID="admin"
ADMIN_PASSWORD="admin1234"
ADMIN_NAME="관리자"

# ── 기타 ─────────────────────────────────────────────────
TZ="Asia/Seoul"
NEXT_PUBLIC_APP_NAME="디자인재성 근태관리"
# 자체 서버(NAS/Windows) 배포 시 1 로 설정
BUILD_STANDALONE="0"
